# local dependency / install trees at the repo root (never committed)
/node_modules/
*.vsix

# local experiment residue at repo root (not part of the build).
# Root-level only: @linxin666 scoped package dirs inside vendor/node_modules
# and plugins/bundled are shipped build content and ARE committed.
/@linxin666/

# flat plugin install tree (source clones / pnpm layout, ~490 MB).
# plugins/bundled is the actual shipped content and IS committed.
plugins/node_modules/

# smoke-test artifacts: old vsix unpack, disposable test DSH_HOME, logs
.smoke/installed/
.smoke/home/
*.log

# platform-shim binaries inside the vendored tree (runtime tools, not source).
# vendor/node_modules itself is committed (the shipped platform tree).
vendor/node_modules/.bin/
# test/debug residue (not part of the build)
/file-review-test*.md
/.review-debug/
/fix-dsh-ripgrep.ps1
