{
  "name": "@dsh-external/dsh-diff-review",
  "version": "0.0.1",
  "description": "Codex-style file-change review: per-turn file diff summary in conversation plus a review tab in the existing sidebar.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nomit8088/dsh-diff-review.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BSD-3-Clause",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "dsh-better-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown -c tsdown.config.ts"
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.8 <1",
    "dsh-better-sidebar": ">=0.14.0 <1"
  },
  "devDependencies": {}
}
