{
  "name": "dsh-archify",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：用 JSON 规格生成可验证的架构图、流程图、时序图、数据流图与生命周期图（移植自 tt-a1i/archify）",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "agent-skill",
    "architecture-diagram",
    "diagram",
    "mermaid",
    "sequence-diagram",
    "workflow",
    "dataflow",
    "lifecycle"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GongYuanCaiJi/dsh-archify.git"
  },
  "homepage": "https://github.com/GongYuanCaiJi/dsh-archify#readme",
  "bugs": {
    "url": "https://github.com/GongYuanCaiJi/dsh-archify/issues"
  },
  "author": "GongYuanCaiJi",
  "scripts": {
    "prepare": "node scripts/stage-skill.mjs",
    "test": "node --test test/*.test.mjs && node scripts/run-skill-tests.mjs",
    "test:skill": "node scripts/run-skill-tests.mjs",
    "pack": "node scripts/pack.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
